{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "system"
  },
  "keybinds": {
    "leader": "ctrl+space",
    "command.palette.show": "ctrl+k",
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d",
    "session.first": "ctrl+g,home",
    "session.last": "ctrl+shift+g,end",
    "session.message.next": "ctrl+n",
    "session.message.previous": "ctrl+p",
    "input.delete.to.line.end": "none",
    "input.delete": "delete,shift+delete"
  },
  "diffs": {
    "wrap": "word",
    "source": "working"
  },
  "session": {
    "sidebar": "hide",
    "thinking": "show"
  },
  "tabs": { "mode": "off" },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4,
    "sound_pack": "opencode.default"
  }
}
